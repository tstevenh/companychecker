# Cloudflare R2 bucket for the company index (R2 > Manage API tokens > create a
# token with Object Read & Write on this bucket). Used by the monthly builder.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Companies House Public Data API key (developer.company-information.service.gov.uk).
# Not needed until the name checker's live confirmation call (Phase 1).
COMPANIES_HOUSE_API_KEY=
