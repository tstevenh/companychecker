---
import Base from '../layouts/Base.astro';
import { PAGES } from '../data/pages';

const tools = PAGES.filter((p) => p.kind === 'tool');
const guides = PAGES.filter((p) => p.kind === 'guide');
---

<Base
  title="Guides and tools for UK limited companies"
  description="Free tools and plain-English guides for starting and running a UK limited company, from name checks and company search to confirmation statements."
  breadcrumbs={[{ name: 'Guides', href: '/guides/' }]}
>
  <h1>Guides and tools</h1>
  <p>
    Everything here is free and based on official Companies House, GOV.UK and HMRC sources. Each fee, deadline and rule
    links to the page it comes from, and the full list is on <a href="/sources/">sources</a>.
  </p>

  <h2>Starting a company</h2>
  <p>
    Pick a name that's available, check you can get the domain and that nobody has trade-marked it, then register. The
    <a href="/register-a-limited-company/">registration guide</a> walks through each step.
  </p>

  <h2>Running a company</h2>
  <p>
    Once registered, a company files a confirmation statement every year and accounts every year, and its directors
    must verify their identity with Companies House. Use the <a href="/company-search/">company search</a> to see any
    company's next deadlines.
  </p>

  <h2>Tools</h2>
  <ul class="directory">
    {
      tools.map((page) => (
        <li>
          <a href={page.href}>{page.title}</a>
          <span>{page.description}</span>
        </li>
      ))
    }
  </ul>

  <h2>Guides</h2>
  <ul class="directory">
    {
      guides.map((page) => (
        <li>
          <a href={page.href}>{page.title}</a>
          <span>{page.description}</span>
        </li>
      ))
    }
  </ul>
</Base>

<style>
  /* An index: title and description per row, ruled like a register */
  .directory {
    list-style: none;
    margin-block: 1.25rem 0;
    padding: 0;
    border-top: 1px solid var(--ink);
  }
  .directory li {
    display: grid;
    gap: 0.2rem;
    margin: 0;
    padding: 1rem 0 1.1rem;
    border-bottom: 1px solid var(--line);
  }
  .directory a {
    font-family: var(--display);
    font-size: 1.3rem;
    letter-spacing: -0.02em;
    line-height: 1.2;
    color: var(--ink);
    text-decoration-color: transparent;
  }
  .directory a:hover {
    color: var(--cobalt);
  }
  .directory span {
    color: var(--ink-2);
    font-size: 0.95rem;
  }
</style>
