---
import Base from '../../layouts/Base.astro';
import Faq from '../../components/Faq.astro';
import Fact from '../../components/Fact.astro';
import Src from '../../components/Src.astro';
import ReminderForm from '../../components/ReminderForm.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import { faqSchema, toolSchema } from '../../lib/schema';
import { remindersAvailable, signUp, type SignUpError } from '../../lib/server/reminders.ts';

export const prerender = false;

const title = 'Companies House deadline reminders: free email alerts';
const description =
  "Free email reminders before your company's confirmation statement and annual accounts are due. Enter your company number; we check the dates with Companies House.";

const ERRORS: Record<SignUpError, string> = {
  email: "That email address doesn't look right. Check it and try again.",
  company: "We couldn't find a company with that number. Check it on your Companies House record and try again.",
  inactive: "That company isn't active on the register, so it has no filing deadlines to remind you about.",
  challenge: "The spam check didn't finish. Wait a moment for it to load, then send the form again.",
  'too-many': "That email address already has reminders for the most companies we allow. Unsubscribe from one first.",
  unavailable: "Reminders aren't working right now. Please try again later.",
};

let sent: string | null = null;
let error: string | null = null;
let form = { company: '', email: '' };

if (Astro.request.method === 'POST') {
  const data = await Astro.request.formData();
  form = { company: String(data.get('company') ?? ''), email: String(data.get('email') ?? '') };
  const result = await signUp({
    email: form.email,
    companyNumber: form.company,
    offers: data.get('offers') === '1',
    turnstileToken: String(data.get('cf-turnstile-response') ?? ''),
    ip: Astro.request.headers.get('cf-connecting-ip'),
  });
  if (result.ok) sent = result.companyName;
  else {
    error = ERRORS[result.error];
    Astro.response.status = result.error === 'unavailable' ? 503 : 400;
  }
}

const faq = [
  {
    q: 'Which deadlines do you remind me about?',
    a: 'The next <a href="/confirmation-statement/">confirmation statement</a> and the next annual accounts, using the due dates on the company\'s Companies House record.',
  },
  {
    q: 'When do the emails arrive?',
    a: 'About 30 days before each deadline and again 7 days before. If you sign up with less than a month to go, the first email comes within a day.',
  },
  {
    q: 'What happens after I file?',
    a: 'Companies House moves the due date on. We check the record every day, so your next reminder follows the new date without you doing anything.',
  },
  {
    q: 'Do you remind me about identity verification?',
    a: 'Yes, in the confirmation statement reminder. Existing directors give their personal code when the company files its next confirmation statement. See <a href="/companies-house-identity-verification/">Companies House identity verification</a>.',
  },
  {
    q: 'What do you do with my email address?',
    a: 'We use it to send the reminders you asked for, and offers only if you ticked the box. Unsubscribing deletes it. See our <a href="/privacy/">privacy policy</a>.',
  },
];
---

<Base
  title={sent ? 'Check your email | Company Name Checker' : title}
  description={description}
  noindex={Astro.request.method === 'POST'}
  breadcrumbs={[{ name: 'Deadline reminders', href: '/reminders/' }]}
  schema={[toolSchema({ name: 'Companies House deadline reminders', description, href: '/reminders/' }), faqSchema(faq)]}
>
  {
    sent ? (
      <>
        <h1>Check your email</h1>
        <p class="lede">
          We've sent a link to <strong>{form.email}</strong>. Click it to start reminders for {sent}. If it hasn't
          arrived in a few minutes, check your spam folder.
        </p>
        <p>
          <a href="/company-search/">Look up another company</a>
        </p>
      </>
    ) : (
      <>
        <h1>Companies House deadline reminders</h1>
        <p class="lede">
          Get an email before your company's confirmation statement and annual accounts are due. Free, with the dates
          checked against Companies House every day.
        </p>
        {error && <p class="notice overdue" role="alert">{error}</p>}
        {remindersAvailable() ? (
          <ReminderForm company={form.company} email={form.email} />
        ) : (
          <p class="notice">Reminders are being set up. Please check back soon.</p>
        )}
        <p class="muted small">
          Don't know your company number? <a href="/company-search/">Search for your company</a> and sign up from its
          page.
        </p>
        <h2>Why reminders help</h2>
        <p>
          A company that doesn't file its confirmation statement can be fined up to <Fact id="cs-late-fine" /> and may be
          struck off.<Src id="cs-late-fine" /> It also can't file the statement until all its directors have verified their
          identity,<Src id="iv-blocks-confirmation-statement" /> so a month's notice leaves time to sort that out first.
        </p>
        <p>
          Both dates move every time the company files, so a reminder that follows the register is easier to rely on than
          a calendar entry.
        </p>
        <Faq items={faq} />
        <RelatedPages heading="Related" hrefs={['/confirmation-statement/', '/companies-house-identity-verification/', '/dormant-company/']} />
      </>
    )
  }
</Base>
