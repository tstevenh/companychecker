---
import { PAGES } from '../data/pages';
import { SITE } from '../data/site';
import { breadcrumbSchema, siteSchema } from '../lib/schema';
import '@fontsource-variable/funnel-display/wght.css';
import '@fontsource-variable/geist/wght.css';
import '@fontsource-variable/geist-mono/wght.css';
import '../styles/global.css';
import funnelFont from '@fontsource-variable/funnel-display/files/funnel-display-latin-wght-normal.woff2?url';
import geistFont from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  // Trail shown above the heading, e.g. [{ name: 'Guides', href: '/guides/' }].
  // Home is added automatically; the current page should be the last item.
  breadcrumbs?: { name: string; href: string }[];
  // Extra JSON-LD objects for this page (Article, FAQPage, WebApplication...).
  schema?: object[];
  ogType?: 'website' | 'article';
  // 'read' sets the page in a single reading column; 'wide' hands the full width
  // to the page, which lays out its own sections.
  layout?: 'read' | 'wide';
}

const { title, description, noindex = false, breadcrumbs, schema = [], ogType = 'website', layout = 'read' } = Astro.props;
const path = Astro.url.pathname;
const nav = [
  { href: '/', label: 'Name checker', current: path === '/' || path.startsWith('/check/') },
  { href: '/company-search/', label: 'Company search', current: path.startsWith('/company') },
  { href: '/guides/', label: 'Guides', current: path === '/guides/' },
];
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.png', Astro.site);
const crumbs = breadcrumbs ? [{ name: 'Home', href: '/' }, ...breadcrumbs] : null;
const jsonLd = [...siteSchema(), ...(crumbs ? [breadcrumbSchema(crumbs)] : []), ...schema];
const tools = PAGES.filter((p) => p.kind === 'tool');
const guides = PAGES.filter((p) => p.kind === 'guide');
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="preload" href={funnelFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={geistFont} as="font" type="font/woff2" crossorigin />
    <meta name="theme-color" content="#fbfbfa" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0c0d11" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Company Name Checker: check a UK company name against every live company" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip" href="#content">Skip to content</a>
    <header class="masthead">
      <div class="masthead__inner">
        <a class="wordmark" href="/" aria-label={`${SITE.name}, home`}>company<span>name</span>checker</a>
        <nav class="masthead__nav" aria-label="Main">
          {nav.map((item) => (
            <a href={item.href} aria-current={item.current ? 'page' : undefined}>{item.label}</a>
          ))}
        </nav>
      </div>
    </header>

    <main id="content" class={layout}>
      {
        crumbs && (
          <nav class:list={['breadcrumbs', { frame: layout === 'wide' }]} aria-label="Breadcrumb">
            <ol>
              {crumbs.map((crumb, i) => (
                <li>{i < crumbs.length - 1 ? <a href={crumb.href}>{crumb.name}</a> : <span aria-current="page">{crumb.name}</span>}</li>
              ))}
            </ol>
          </nav>
        )
      }
      <slot />
    </main>

    <footer class="footer">
      <div class="footer__inner">
        <div class="footer__top">
          <a class="wordmark" href="/">company<span>name</span>checker</a>
          <p>Free, independent tools and guides for starting and running a UK limited company.</p>
        </div>
        <div class="footer__columns">
          <nav aria-label="Tools">
            <h2>Tools</h2>
            <ul>{tools.map((p) => <li><a href={p.href}>{p.title}</a></li>)}</ul>
          </nav>
          <nav aria-label="Guides">
            <h2>Guides</h2>
            <ul>{guides.map((p) => <li><a href={p.href}>{p.title}</a></li>)}</ul>
          </nav>
          <nav aria-label="About this site">
            <h2>About</h2>
            <ul>
              <li><a href="/about/">About us</a></li>
              <li><a href="/sources/">Sources</a></li>
              <li><a href="/data-updates/">Data updates</a></li>
              <li><a href="/disclosure/">Affiliate disclosure</a></li>
              <li><a href="/privacy/">Privacy</a></li>
              <li><a href="/terms/">Terms</a></li>
            </ul>
          </nav>
        </div>
        <p class="footer__note">
          Independent service. Not affiliated with Companies House or the UK government. Only Companies House can accept a
          company name when you file.
        </p>
      </div>
    </footer>
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: 1rem;
    top: -4rem;
    z-index: 10;
    padding: 0.6rem 1rem;
    border-radius: 999px;
    background: var(--cobalt-fill);
    color: var(--on-cobalt);
    font-weight: 600;
  }
  .skip:focus {
    top: 1rem;
  }

  .masthead {
    border-bottom: 1px solid var(--line);
    background: color-mix(in srgb, var(--bg) 92%, transparent);
  }
  .masthead__inner {
    max-width: var(--max-wide);
    margin-inline: auto;
    padding: 0 var(--gutter);
    min-height: 4rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.25rem 2rem;
  }
  .wordmark {
    font-family: var(--display);
    font-weight: 600;
    font-size: 1.2rem;
    letter-spacing: -0.025em;
    color: var(--ink);
    text-decoration: none;
    white-space: nowrap;
  }
  .wordmark span {
    color: var(--cobalt);
  }
  .masthead__nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.75rem;
  }
  .masthead__nav a {
    padding: 0.5rem 0;
    font-size: 0.93rem;
    color: var(--ink-2);
    text-decoration: none;
  }
  .masthead__nav a:hover,
  .masthead__nav a[aria-current='page'] {
    color: var(--ink);
  }
  .masthead__nav a[aria-current='page'] {
    box-shadow: inset 0 -2px 0 var(--cobalt);
  }
  @media (max-width: 40rem) {
    .masthead__inner {
      padding-block: 0.75rem 0.25rem;
    }
    .masthead__nav {
      width: 100%;
      gap: 0.25rem 1.25rem;
    }
  }

  .footer {
    border-top: 1px solid var(--line);
    font-size: 0.93rem;
    color: var(--ink-2);
  }
  .footer__inner {
    max-width: var(--max-wide);
    margin-inline: auto;
    padding: 3.5rem var(--gutter) 2.5rem;
  }
  .footer__top {
    display: grid;
    gap: 0.6rem;
    padding-bottom: 2.5rem;
  }
  .footer__top p {
    margin: 0;
    max-width: 32em;
  }
  .footer__columns {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    gap: 2rem;
  }
  .footer h2 {
    font-family: var(--sans);
    font-weight: 500;
    font-size: 0.85rem;
    letter-spacing: 0;
    color: var(--ink);
    margin: 0 0 0.85rem;
  }
  .footer ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.45rem;
  }
  .footer li {
    margin: 0;
  }
  .footer a:not(.wordmark) {
    color: var(--ink-2);
    text-decoration-color: transparent;
  }
  .footer a:not(.wordmark):hover {
    color: var(--ink);
    text-decoration-color: currentColor;
  }
  .footer__note {
    margin: 2.75rem 0 0;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
    font-size: 0.85rem;
    max-width: 52rem;
  }
</style>
