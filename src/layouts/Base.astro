---
import { PAGES } from '../data/pages';
import { SITE } from '../data/site';
import { breadcrumbSchema, siteSchema } from '../lib/schema';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  // Trail shown above the heading, e.g. [{ name: 'Guides', href: '/guides/' }].
  // Home is added automatically; the current page should be the last item.
  breadcrumbs?: { name: string; href: string }[];
  // Extra JSON-LD objects for this page (Article, FAQPage, WebApplication...).
  schema?: object[];
  ogType?: 'website' | 'article';
}

const { title, description, noindex = false, breadcrumbs, schema = [], ogType = 'website' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const crumbs = breadcrumbs ? [{ name: 'Home', href: '/' }, ...breadcrumbs] : null;
const jsonLd = [...siteSchema(), ...(crumbs ? [breadcrumbSchema(crumbs)] : []), ...schema];
const tools = PAGES.filter((p) => p.kind === 'tool');
const guides = PAGES.filter((p) => p.kind === 'guide');
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="en_GB" />
    <meta name="twitter:card" content="summary" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/">{SITE.name}</a>
      <nav aria-label="Main">
        <a href="/">Name checker</a>
        <a href="/company-search/">Company search</a>
        <a href="/guides/">Guides</a>
      </nav>
    </header>

    <main>
      {
        crumbs && (
          <nav class="breadcrumbs" aria-label="Breadcrumb">
            <ol>
              {crumbs.map((crumb, i) => (
                <li>{i < crumbs.length - 1 ? <a href={crumb.href}>{crumb.name}</a> : <span aria-current="page">{crumb.name}</span>}</li>
              ))}
            </ol>
          </nav>
        )
      }
      <slot />
    </main>

    <footer class="site-footer">
      <div class="footer-columns">
        <nav aria-label="Tools">
          <h2>Tools</h2>
          <ul>{tools.map((p) => <li><a href={p.href}>{p.title}</a></li>)}</ul>
        </nav>
        <nav aria-label="Guides">
          <h2>Guides</h2>
          <ul>{guides.map((p) => <li><a href={p.href}>{p.title}</a></li>)}</ul>
        </nav>
        <nav aria-label="About this site">
          <h2>About</h2>
          <ul>
            <li><a href="/about/">About us</a></li>
            <li><a href="/sources/">Sources</a></li>
            <li><a href="/data-updates/">Data updates</a></li>
            <li><a href="/disclosure/">Affiliate disclosure</a></li>
            <li><a href="/privacy/">Privacy</a></li>
            <li><a href="/terms/">Terms</a></li>
          </ul>
        </nav>
      </div>
      <p>
        Independent service. Not affiliated with Companies House or the UK government. Only Companies House can accept a
        company name when you file.
      </p>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --bg: #ffffff;
    --text: #1b1f24;
    --muted: #5b6470;
    --line: #e3e6ea;
    --accent: #0b5cad;
    --max: 46rem;
    color-scheme: light dark;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #111418;
      --text: #e8eaed;
      --muted: #a2a9b3;
      --line: #2a2f36;
      --accent: #6aa8ff;
    }
  }
  * {
    box-sizing: border-box;
  }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font: 1rem/1.6 system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
  }
  a {
    color: var(--accent);
  }
  main,
  .site-header,
  .site-footer {
    max-width: var(--max);
    margin: 0 auto;
    padding: 0 1rem;
  }
  .site-header {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: space-between;
    align-items: center;
    padding-top: 1rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--line);
  }
  .site-header nav {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }
  .brand {
    font-weight: 700;
    color: var(--text);
    text-decoration: none;
  }
  main {
    padding-top: 1.5rem;
    padding-bottom: 3rem;
  }
  .breadcrumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    padding: 0;
    margin: 0 0 1rem;
    font-size: 0.9rem;
    color: var(--muted);
  }
  .breadcrumbs li + li::before {
    content: '›';
    margin-right: 0.4rem;
  }
  .site-footer {
    border-top: 1px solid var(--line);
    padding-top: 1.5rem;
    padding-bottom: 2rem;
    color: var(--muted);
    font-size: 0.9rem;
  }
  .footer-columns {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    gap: 1.5rem;
  }
  .footer-columns h2 {
    font-size: 0.95rem;
    color: var(--text);
    margin: 0 0 0.5rem;
  }
  .footer-columns ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.3rem;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.95rem;
  }
  th,
  td {
    text-align: left;
    vertical-align: top;
    padding: 0.5rem 0.5rem 0.5rem 0;
    border-bottom: 1px solid var(--line);
  }
  .table-wrap {
    overflow-x: auto;
  }
  .muted {
    color: var(--muted);
  }
  .small {
    font-size: 0.85rem;
  }
  code {
    font-size: 0.92em;
    background: var(--line);
    padding: 0.05rem 0.3rem;
    border-radius: 4px;
    word-break: break-all;
  }
</style>
