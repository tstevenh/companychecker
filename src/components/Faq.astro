---
// A questions-and-answers section. Answers are HTML strings so they can contain
// links; pass the same list to the page's FAQPage structured data via faqSchema().
import Icon from './ui/Icon.astro';

interface Props {
  items: { q: string; a: string }[];
  heading?: string;
  // Heading in its own column beside the questions (wide pages).
  split?: boolean;
}

const { items, heading = 'Frequently asked questions', split = false } = Astro.props;
---

<section class:list={['faq', { 'faq--split': split }]}>
  <h2>{heading}</h2>
  <div class="faq__list">
    {
      items.map((item) => (
        <details>
          <summary>
            <span>{item.q}</span>
            <Icon name="caretDown" class="faq__caret" />
          </summary>
          <div class="faq__answer" set:html={item.a} />
        </details>
      ))
    }
  </div>
</section>

<style>
  .faq {
    margin-top: 4rem;
  }
  .faq__list {
    border-top: 1px solid var(--ink);
  }
  details {
    border-bottom: 1px solid var(--line);
  }
  summary {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1.25rem;
    padding: 1.1rem 0;
    cursor: pointer;
    list-style: none;
    font-weight: 500;
    font-size: 1.05rem;
    line-height: 1.4;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary:hover span {
    color: var(--cobalt);
  }
  summary :global(.faq__caret) {
    flex: none;
    width: 1rem;
    height: 1rem;
    color: var(--ink-3);
    transform: translateY(0.15rem);
    transition: transform 0.3s var(--ease-out);
  }
  details[open] summary :global(.faq__caret) {
    transform: translateY(0.15rem) rotate(180deg);
  }
  .faq__answer {
    padding: 0 2.25rem 1.25rem 0;
    color: var(--ink-2);
  }
  .faq__answer :global(p:last-child) {
    margin-bottom: 0;
  }
  @media (min-width: 60rem) {
    .faq--split {
      display: grid;
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: 3rem;
      align-items: start;
    }
    .faq--split h2 {
      margin-top: 0;
      position: sticky;
      top: 2rem;
    }
  }
</style>
