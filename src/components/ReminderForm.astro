---
// Deadline reminder sign-up. Posts to /reminders/, which sends a confirmation
// email. Pass the company when the page already knows it (a company page);
// otherwise the form asks for the company number. Renders nothing until the
// reminder service is configured (D1, Turnstile and Resend).
import Icon from './ui/Icon.astro';
import { remindersAvailable, turnstileSiteKey } from '../lib/server/reminders.ts';

interface Props {
  companyNumber?: string;
  companyName?: string;
  // Values to put back in the fields after a failed submit.
  company?: string;
  email?: string;
}

const { companyNumber, companyName, company = '', email = '' } = Astro.props;
const id = Math.random().toString(36).slice(2, 8);
const available = remindersAvailable();
---

{
  available && (
    <form class="reminder-form" action="/reminders/" method="post">
      {companyNumber ? (
        <input type="hidden" name="company" value={companyNumber} />
      ) : (
        <div class="field">
          <label for={`company-${id}`}>Company number</label>
          <div class="row">
            <input id={`company-${id}`} name="company" type="text" value={company} maxlength={10} required autocomplete="off" spellcheck="false" placeholder="e.g. 01234567" />
          </div>
        </div>
      )}
      <div class="field">
        <label for={`email-${id}`}>{companyName ? `Email me before ${companyName}'s deadlines` : 'Your email'}</label>
        <div class="row">
          <input id={`email-${id}`} name="email" type="email" value={email} maxlength={254} required autocomplete="email" placeholder="you@example.co.uk" />
          <button class="button" type="submit">Send reminders<Icon name="arrowRight" /></button>
        </div>
      </div>
      <label class="consent">
        <input type="checkbox" name="offers" value="1" />
        <span>Also send me occasional offers that suit a company like mine. Optional.</span>
      </label>
      <div class="cf-turnstile" data-sitekey={turnstileSiteKey()} data-size="flexible" />
      <p class="muted small">
        We email 30 days and 7 days before the confirmation statement and accounts are due. Free, and every email has an
        unsubscribe link. See our <a href="/privacy/">privacy policy</a>.
      </p>
    </form>
  )
}
{/* No integrity hash: Cloudflare updates this script in place and says not to pin it. */}
{available && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer />}

<style>
  .reminder-form {
    display: grid;
    gap: 1.1rem;
    margin: 1.5rem 0 2rem;
  }
  .consent {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    font-size: 0.95rem;
    color: var(--ink-2);
    cursor: pointer;
  }
  .consent input {
    width: 1.1rem;
    height: 1.1rem;
    margin: 0.2rem 0 0;
    flex: none;
    accent-color: var(--cobalt);
  }
  .reminder-form p {
    margin: 0;
  }
</style>
