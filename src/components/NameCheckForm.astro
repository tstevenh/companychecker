---
import Icon from './ui/Icon.astro';
interface Props {
  value?: string;
  autofocus?: boolean;
}

const { value = '', autofocus = false } = Astro.props;
---

<form class="name-check field" action="/check/" method="get" role="search">
  <label for="company-name">Company name</label>
  <div class="row">
    <input
      id="company-name"
      name="name"
      type="text"
      value={value}
      maxlength="160"
      required
      autocomplete="off"
      spellcheck="false"
      placeholder="e.g. Acme Widgets Ltd"
      autofocus={autofocus}
    />
    <button class="button" type="submit">Check name<Icon name="arrowRight" /></button>
  </div>
</form>

