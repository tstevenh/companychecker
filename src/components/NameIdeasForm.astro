---
import Icon from './ui/Icon.astro';
interface Props {
  value?: string;
}

const { value = '' } = Astro.props;
---

<form class="ideas-form field" action="/business-name-generator/ideas/" method="get">
  <label for="keywords">Describe your business in 1 to 3 words</label>
  <div class="row">
    <input id="keywords" name="keywords" type="text" value={value} maxlength="80" required autocomplete="off" placeholder="e.g. bakery sourdough" />
    <button class="button" type="submit">Generate names<Icon name="arrowRight" /></button>
  </div>
</form>

