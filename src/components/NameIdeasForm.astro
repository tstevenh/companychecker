---
interface Props {
  value?: string;
}

const { value = '' } = Astro.props;
---

<form class="ideas-form" action="/business-name-generator/ideas/" method="get">
  <label for="keywords">Describe your business in 1 to 3 words</label>
  <div class="row">
    <input id="keywords" name="keywords" type="text" value={value} maxlength="80" required autocomplete="off" placeholder="e.g. bakery sourdough" />
    <button type="submit">Generate names</button>
  </div>
</form>

<style>
  .ideas-form {
    margin: 1.5rem 0;
  }
  label {
    display: block;
    font-weight: 600;
    margin-bottom: 0.4rem;
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  input {
    flex: 1 1 16rem;
    min-width: 0;
    font: inherit;
    padding: 0.7rem 0.8rem;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: var(--bg);
    color: var(--text);
  }
  input:focus {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
  }
  button {
    font: inherit;
    font-weight: 600;
    padding: 0.7rem 1.2rem;
    border: 0;
    border-radius: 6px;
    background: var(--accent);
    color: var(--bg);
    cursor: pointer;
  }
</style>
