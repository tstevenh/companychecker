---
import Icon from './ui/Icon.astro';
interface Props {
  action: string;
  name: string;
  label: string;
  button: string;
  placeholder?: string;
  value?: string;
  maxlength?: number;
}

const { action, name, label, button, placeholder = '', value = '', maxlength = 160 } = Astro.props;
const id = `${name}-${Math.random().toString(36).slice(2, 8)}`;
---

<form class="tool-form field" action={action} method="get">
  <label for={id}>{label}</label>
  <div class="row">
    <input id={id} name={name} type="text" value={value} maxlength={maxlength} required autocomplete="off" spellcheck="false" placeholder={placeholder} />
    <button class="button" type="submit">{button}<Icon name="arrowRight" /></button>
  </div>
</form>

