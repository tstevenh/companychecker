---
import Icon from './ui/Icon.astro';
interface Props {
  value?: string;
  label?: string;
  placeholder?: string;
  button?: string;
}

const {
  value = '',
  label = 'Company name or number',
  placeholder = 'e.g. Acme Widgets or 01234567',
  button = 'Search',
} = Astro.props;
const id = `company-q-${Math.random().toString(36).slice(2, 8)}`;
---

<form class="company-search field" action="/company-search/results/" method="get" role="search">
  <label for={id}>{label}</label>
  <div class="row">
    <input id={id} name="q" type="text" value={value} maxlength="160" required autocomplete="off" spellcheck="false" placeholder={placeholder} />
    <button class="button" type="submit">{button}<Icon name="arrowRight" /></button>
  </div>
</form>

